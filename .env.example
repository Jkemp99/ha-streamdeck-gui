# Copy to .env and fill in values. Nothing here is required to start the GUI;
# every setting can also be entered in the Settings page.

# Bind address. Use 0.0.0.0 so other devices on the LAN can reach the GUI.
HOST=0.0.0.0
PORT=8080

# Absolute path to the streamdeck.yaml file this GUI will edit.
STREAMDECK_YAML_PATH=

# Home Assistant base URL including scheme and port.
# Example: http://192.168.1.10:8123
# Do not split host and port — the token and URL stay on the server.
HA_URL=
HA_TOKEN=

# One of: mini, original, mk2, xl, plus, neo
DECK_MODEL=

# How many timestamped backups to keep next to the YAML file.
BACKUP_COUNT=10

# Optional systemd unit name for the streamdeck YAML service (no .service suffix needed).
SYSTEMD_SERVICE_NAME=

# Directory for the GUI's own settings file (token is stored here, mode 0600).
# Defaults to $XDG_CONFIG_HOME/ha-streamdeck-gui or ~/.config/ha-streamdeck-gui
# HA_STREAMDECK_GUI_CONFIG_DIR=
